// Base du site (espace membre). Toute modification passe par une migration :
//   docker compose exec app npx prisma migrate dev --name <description>
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  pending
  approved
  rejected
}

// Compte de l’espace membre, créé à la première connexion Discord
model Member {
  id           Int          @id @default(autoincrement())
  discordId    String       @unique @map("discord_id") @db.VarChar(32)
  username     String       @db.VarChar(64) // pseudo Discord
  avatar       String?      @db.VarChar(128) // hash de l'avatar Discord
  displayName  String?      @map("display_name") @db.VarChar(64) // nom RP
  rankKey      String?      @map("rank") @db.VarChar(20) // null = sans grade
  bio          String?
  phoneRp      String?      @map("phone_rp") @db.VarChar(32)
  status       MemberStatus @default(pending)
  isOwner      Boolean      @default(false) @map("is_owner") // propriétaire du serveur Discord
  memberRole   String?      @map("member_role") @db.VarChar(32) // rôle Discord membre porté (null = aucun) : relu à chaque connexion, et toutes les 10 minutes par le bot (synchro-discord.ts)
  leftGuildAt  DateTime?    @map("left_guild_at") @db.Timestamptz(6) // parti du serveur Discord (vu par le bot) : sessions fermées ; effacé à la connexion Discord suivante
  joinedAt     DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastLogin    DateTime?    @map("last_login") @db.Timestamptz(6)
  approvedAt   DateTime?    @map("approved_at") @db.Timestamptz(6)
  approvedById Int?         @map("approved_by")

  rank       Rank?     @relation(fields: [rankKey], references: [key], onDelete: Restrict)
  approvedBy Member?   @relation("Approvals", fields: [approvedById], references: [id], onDelete: SetNull)
  approved   Member[]  @relation("Approvals")
  messages   Message[]
  chatRead   ChatRead?

  @@index([rankKey])
  @@map("members")
}

// Grade de la hiérarchie, paramétré dans Gestion → Hiérarchie
model Rank {
  key           String  @id @db.VarChar(20) // identifiant technique, fixé à la création
  label         String  @db.VarChar(40)
  position      Int     @default(0) // 0 = sommet
  color         String? @db.VarChar(7)
  description   String? // texte public sous la rangée de l'organigramme
  featured      Boolean @default(false) // grande carte sur l'organigramme public
  canAdmin      Boolean @default(false) @map("can_admin") // accès à la Gestion
  canManage     Boolean @default(false) @map("can_manage") // pouvoirs complets
  isDefault     Boolean @default(false) @map("is_default") // grade des nouveaux comptes (un seul)
  discordRoleId String? @unique @map("discord_role_id") @db.VarChar(32)

  members    Member[]
  orgEntries OrgEntry[]

  @@map("ranks")
}

// Case de l'organigramme public (nom libre, sans lien avec les comptes)
model OrgEntry {
  id          Int     @id @default(autoincrement())
  rankKey     String  @map("rank") @db.VarChar(20)
  name        String  @db.VarChar(64)
  subtitle    String? @db.VarChar(80)
  description String?
  isOpen      Boolean @default(false) @map("is_open") // poste à pourvoir
  position    Int     @default(0)

  rank Rank @relation(fields: [rankKey], references: [key], onDelete: Restrict)

  @@index([rankKey, position])
  @@map("org_entries")
}

// Message du chat
model Message {
  id        Int       @id @default(autoincrement())
  memberId  Int       @map("member_id")
  content   String    @db.VarChar(1000)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("messages")
}

// Dernier message lu dans le chat (badge « non lus »)
model ChatRead {
  memberId   Int      @id @map("member_id")
  lastReadId Int      @default(0) @map("last_read_id")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("chat_reads")
}

// Réglages du site modifiables depuis l'espace membre (Gestion → Hiérarchie), clé → valeur
model Setting {
  key   String @id @db.VarChar(40)
  value String

  @@map("settings")
}

// Sessions de connexion (gérées par connect-pg-simple, déclarées ici pour les migrations)
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "idx_session_expire")
  @@map("session")
}
